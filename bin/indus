#!/usr/bin/env ruby
# indus file.rb            compile and run in-process (JIT-style)
# indus file.rb -o out     write a standalone executable (Mach-O; --linux for ELF)
# indus file.rb --check    compile only; exit 0 if Indus accepts the program
require_relative "../lib/indus"
require_relative "../lib/indus/macho"
require_relative "../lib/indus/elf"

file = ARGV[0] or abort "usage: indus file.rb [-o out] | indus -e 'code'"
if file == "-e" then src_inline = ARGV[1] or abort "indus -e needs code"; file = "-e" end
out = ARGV[ARGV.index("-o") + 1] if ARGV.include?("-o")
src = src_inline || File.read(file)

if ARGV.include?("--check")
  begin
    Indus.compile(src, file: file)
  rescue => e
    $stderr.puts "indus: #{e.message.lines.first.strip}"
    exit 1
  end
  exit 0
end
if out
  os = ARGV.include?("--linux") ? :linux : :darwin
  unit = Indus.compile(src, standalone: os, file: file)
  os == :linux ? Indus::ELF.write(out, unit.code) : Indus::MachO.write(out, unit.code)
  $stderr.puts "indus: #{out} (#{unit.code.bytesize} bytes of code, #{File.size(out)} bytes on disk)"
else
  unit = Indus.compile(src, file: file)
  if ENV["HEX"] then unit.code.unpack("V*").each_with_index { |w, i| printf("%4d: %08x\n", i * 4, w) }; exit end
  t = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  Indus::Metal.run(unit)
  $stderr.puts "indus: #{unit.code.bytesize} bytes, #{((Process.clock_gettime(Process::CLOCK_MONOTONIC) - t) * 1000).round(1)} ms"
end
