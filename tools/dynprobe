#!/bin/bash
# tools/dynprobe [N...]: run the 64 dynamic-Ruby idioms (test/probes/dynamic64.txt) against CRuby; prints pass count and failing numbers
cd "$(dirname "$0")/.."; mkdir -p /tmp/dyn2; i=0; pass=0; fails=""
while IFS= read -r c; do i=$((i+1)); printf '%s\n' "$c" > /tmp/dyn2/t$i.rb
  if [ $# -gt 0 ] && ! printf '%s\n' "$@" | grep -qx "$i"; then continue; fi
  got=$(INDUS_HEAP_MB=32 timeout 10 bin/indus /tmp/dyn2/t$i.rb 2>/dev/null | head -5 | tr '\n' '|'); want=$(ruby --disable-gems /tmp/dyn2/t$i.rb 2>/dev/null | head -5 | tr '\n' '|')
  if [ "$got" = "$want" ]; then pass=$((pass+1)); else fails="$fails $i"; [ $# -gt 0 ] && { echo "t$i: $c" | cut -c1-110; INDUS_HEAP_MB=32 timeout 10 bin/indus /tmp/dyn2/t$i.rb 2>&1 | grep -v '^indus:\|^\s*from' | head -1 | sed 's/.*in .[^:]*.: //' | cut -c1-120; }; fi
done < test/probes/dynamic64.txt
echo "probe: $pass / $i; failing:$fails"
